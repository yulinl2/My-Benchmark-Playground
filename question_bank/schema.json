{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rutgers Stat PhD Qual Question",
  "description": "A single transcribed question (or multi-part problem) from a Rutgers Statistics PhD qualifying exam.",
  "type": "object",
  "required": ["id", "exam", "number", "topics", "prompt", "source"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable unique id, convention: <year>-<term>-<part>-q<number>, e.g. 2019-fall-probability-q3",
      "pattern": "^[0-9]{4}-[a-z]+-[a-z-]+-q[0-9]+[a-z]?$"
    },
    "exam": {
      "type": "object",
      "required": ["year", "term", "part"],
      "additionalProperties": false,
      "properties": {
        "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
        "term": { "type": "string", "enum": ["spring", "summer", "fall", "winter", "unknown"] },
        "part": {
          "type": "string",
          "description": "Which part of the qual this came from.",
          "enum": ["probability", "math-stat", "applied", "other"]
        }
      }
    },
    "number": {
      "type": "integer",
      "description": "Problem number as printed on the exam.",
      "minimum": 1
    },
    "topics": {
      "type": "array",
      "description": "Free-form topic tags, e.g. 'CLT', 'MLE', 'sufficiency', 'linear regression'.",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "difficulty": {
      "type": ["string", "null"],
      "enum": ["easy", "medium", "hard", null],
      "description": "Optional subjective difficulty."
    },
    "prompt": {
      "type": "string",
      "description": "The full problem statement, Markdown + LaTeX (use $...$ / $$...$$).",
      "minLength": 1
    },
    "parts": {
      "type": "array",
      "description": "Optional list of sub-parts (a), (b), ... if you want them itemized.",
      "items": { "type": "string" }
    },
    "solution": {
      "type": ["string", "null"],
      "description": "Optional worked solution (Markdown + LaTeX). null/omit if not transcribed."
    },
    "source": {
      "type": "object",
      "required": ["pdf"],
      "additionalProperties": false,
      "properties": {
        "pdf": { "type": "string", "description": "Path under exams/pdfs/ this was transcribed from." },
        "page": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "verified": {
      "type": "boolean",
      "description": "Whether a human has checked the transcription against the source PDF.",
      "default": false
    },
    "notes": {
      "type": "string",
      "description": "Any transcriber notes (ambiguities, OCR issues, etc.)."
    }
  }
}
